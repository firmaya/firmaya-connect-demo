# Copia este archivo como .env y completa los valores.

# Base de la API de Connect.
#   Local (backend en Docker):  http://localhost:8000/api/connect/v1
#   Producción:                 https://api.firmaya.cr/api/connect/v1
FIRMAYA_API_URL=http://localhost:8000/api/connect/v1

# Llave de API del ambiente (panel → Connect → Configuración → Llaves de API).
# Staging empieza con fy_stg_, producción con fy_live_.
FIRMAYA_API_KEY=fy_stg_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Secreto de firma del webhook del MISMO ambiente (panel → Configuración → Webhook).
FIRMAYA_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Dirección pública donde FirmaYa entrega los eventos; debe llegar a este
# servidor en /webhook. Para pruebas locales, un túnel (ngrok, cloudflared):
#   WEBHOOK_URL=https://abc123.ngrok-free.app/webhook
WEBHOOK_URL=

# Puerto de este proyecto.
PORT=4000
